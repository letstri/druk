{
  "name": "druk",
  "displayName": "Druk",
  "version": "1.35.3",
  "private": true,
  "description": "A terminal code editor — file tree, tabs, tree-sitter syntax highlighting and search; keyboard and mouse driven.",
  "keywords": [
    "bun",
    "cli",
    "code-editor",
    "editor",
    "opentui",
    "search",
    "syntax-highlighting",
    "terminal",
    "tree-sitter",
    "tui"
  ],
  "homepage": "https://github.com/letstri/druk",
  "bugs": {
    "url": "https://github.com/letstri/druk/issues"
  },
  "license": "MIT",
  "author": "Valerii Strilets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letstri/druk.git"
  },
  "funding": "https://github.com/sponsors/letstri",
  "bin": {
    "druk": "./bin/druk.js"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build.ts",
    "release": "bun scripts/release.ts",
    "formula": "bun scripts/formula.ts",
    "packages": "bun scripts/packages.ts",
    "extensions": "bun scripts/extensions.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run check-types && bun run lint && bun run format:check && bun run test",
    "test": "bun scripts/test.ts",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.15",
    "tree-sitter-wasms": "^0.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fast-png": "^8.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^5",
    "typescript-language-server": "^5.3.0",
    "ultracite": "^7.12.0"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "//private": "What npm publishes is staged by scripts/release.ts, never this directory."
}
