{
  "name": "druk",
  "displayName": "Druk",
  "version": "1.6.0",
  "private": true,
  "description": "A terminal code editor — file tree, tabs, tree-sitter syntax highlighting and search; keyboard and mouse driven.",
  "keywords": [
    "bun",
    "cli",
    "code-editor",
    "editor",
    "opentui",
    "search",
    "syntax-highlighting",
    "terminal",
    "tree-sitter",
    "tui"
  ],
  "homepage": "https://github.com/letstri/druk",
  "bugs": {
    "url": "https://github.com/letstri/druk/issues"
  },
  "license": "MIT",
  "author": "Valerii Strilets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letstri/druk.git"
  },
  "funding": "https://github.com/sponsors/letstri",
  "bin": {
    "druk": "./bin/druk.js"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build.ts",
    "release": "bun scripts/release.ts",
    "formula": "bun scripts/formula.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run check-types && bun run lint && bun run format:check && bun run test",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "nypm": "^0.6.8",
    "solid-js": "^1.9.14",
    "tree-sitter-wasms": "^0.1.13"
  },
  "devDependencies": {
    "@letstri/oxlint-config": "^1.2.2",
    "@types/bun": "latest",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
