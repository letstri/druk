{
  "id": "hcl",
  "name": "HCL and Terraform",
  "version": "1.1.0",
  "description": "HashiCorp configuration: `.tf`, `.tfvars` and `.hcl`, by patterns.",
  "languages": [
    {
      "id": "terraform",
      "label": "tf",
      "lineComment": "#",
      "patterns": [
        {
          "group": "punctuation.bracket",
          "re": "[{}[\\]()]",
          "flags": "g"
        },
        {
          "group": "punctuation",
          "re": "[,.:]",
          "flags": "g"
        },
        {
          "group": "operator",
          "re": "=>|[=!<>]=|&&|\\|\\||[=<>+\\-*/%!?:]",
          "flags": "g"
        },
        {
          "group": "number",
          "re": "\\b\\d+(?:\\.\\d+)?\\b",
          "flags": "g"
        },
        {
          "group": "boolean",
          "re": "\\b(?:true|false|null)\\b",
          "flags": "g"
        },
        {
          "group": "type",
          "re": "\\b(?:string|number|bool|any|list|map|set|object|tuple)\\b",
          "flags": "g"
        },
        {
          "group": "keyword",
          "re": "\\b(?:resource|variable|output|module|provider|data|locals|terraform|backend|provisioner|connection|lifecycle|dynamic|moved|import|check|removed|depends_on|for|in|if|else)\\b",
          "flags": "g"
        },
        {
          "group": "property",
          "re": "^[ \\t]*[\\w-]+(?=[ \\t]*=(?!=))",
          "flags": "gm"
        },
        {
          "group": "function",
          "re": "\\b[a-z_]\\w*(?=\\()",
          "flags": "g"
        },
        {
          "group": "string",
          "re": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "flags": "g"
        },
        {
          "group": "string",
          "re": "<<[-~]?(\\w+)[\\s\\S]*?^[ \\t]*\\1\\b",
          "flags": "gm"
        },
        {
          "group": "variable",
          "re": "(?<![\\w/.])(?:var|local|data|module|each|count|path|self|terraform)(?:\\.\\w+)+",
          "flags": "g"
        },
        {
          "group": "punctuation.special",
          "re": "\\$\\{|%\\{",
          "flags": "g"
        },
        {
          "group": "comment",
          "re": "(?:^|[ \\t])(?:#|\\/\\/).*|\\/\\*[\\s\\S]*?\\*\\/",
          "flags": "gm"
        }
      ],
      "extensions": [".tf", ".tfvars"]
    },
    {
      "id": "hcl",
      "lineComment": "#",
      "patterns": [
        {
          "group": "punctuation.bracket",
          "re": "[{}[\\]()]",
          "flags": "g"
        },
        {
          "group": "punctuation",
          "re": "[,.:]",
          "flags": "g"
        },
        {
          "group": "operator",
          "re": "=>|[=!<>]=|&&|\\|\\||[=<>+\\-*/%!?:]",
          "flags": "g"
        },
        {
          "group": "number",
          "re": "\\b\\d+(?:\\.\\d+)?\\b",
          "flags": "g"
        },
        {
          "group": "boolean",
          "re": "\\b(?:true|false|null)\\b",
          "flags": "g"
        },
        {
          "group": "type",
          "re": "\\b(?:string|number|bool|any|list|map|set|object|tuple)\\b",
          "flags": "g"
        },
        {
          "group": "keyword",
          "re": "\\b(?:resource|variable|output|module|provider|data|locals|terraform|backend|provisioner|connection|lifecycle|dynamic|moved|import|check|removed|depends_on|for|in|if|else)\\b",
          "flags": "g"
        },
        {
          "group": "property",
          "re": "^[ \\t]*[\\w-]+(?=[ \\t]*=(?!=))",
          "flags": "gm"
        },
        {
          "group": "function",
          "re": "\\b[a-z_]\\w*(?=\\()",
          "flags": "g"
        },
        {
          "group": "string",
          "re": "\"(?:[^\"\\\\\\n]|\\\\.)*\"",
          "flags": "g"
        },
        {
          "group": "string",
          "re": "<<[-~]?(\\w+)[\\s\\S]*?^[ \\t]*\\1\\b",
          "flags": "gm"
        },
        {
          "group": "variable",
          "re": "(?<![\\w/.])(?:var|local|data|module|each|count|path|self|terraform)(?:\\.\\w+)+",
          "flags": "g"
        },
        {
          "group": "punctuation.special",
          "re": "\\$\\{|%\\{",
          "flags": "g"
        },
        {
          "group": "comment",
          "re": "(?:^|[ \\t])(?:#|\\/\\/).*|\\/\\*[\\s\\S]*?\\*\\/",
          "flags": "gm"
        }
      ],
      "extensions": [".hcl"]
    }
  ]
}
