{
  "id": "one-dark",
  "name": "One Dark",
  "version": "1.1.0",
  "description": "Atom One Dark. Colors from atom/atom `one-dark-syntax` (`styles/colors.less`, resolved from HSL) and `one-dark-ui`; the capture groups follow the \"Official Syntax Variables\" in `styles/syntax-variables.less` and `styles/syntax/base.less`.",
  "themes": [
    {
      "id": "one-dark",
      "name": "One Dark",
      "ui": {
        "bg": "#282c34",
        "panelBg": "#21252b",
        "barBg": "#1b1d23",
        "statusBg": "#528bff",
        "statusFg": "#ffffff",
        "text": "#abb2bf",
        "dim": "#828997",
        "faint": "#5c6370",
        "accent": "#528bff",
        "activeTabFg": "#abb2bf",
        "inactiveTabFg": "#828997",
        "treeSelectedBg": "#3a3f4b",
        "treeFocusBg": "#31363f",
        "dirty": "#e2c08d",
        "error": "#ff6347",
        "folder": "#abb2bf",
        "cursor": "#528bff",
        "scrollbar": "#5c6370",
        "gutter": "#636d83",
        "currentLine": "#2d323c",
        "indentGuide": "#32363e",
        "gitAdded": "#43d08a",
        "gitModified": "#e0c285",
        "gitDeleted": "#e05252"
      },
      "syntax": {
        "comment": {
          "fg": "#5c6370",
          "italic": true
        },
        "keyword": {
          "fg": "#c678dd"
        },
        "string": {
          "fg": "#98c379"
        },
        "number": {
          "fg": "#d19a66"
        },
        "boolean": {
          "fg": "#d19a66"
        },
        "constant": {
          "fg": "#d19a66"
        },
        "function": {
          "fg": "#61afef"
        },
        "constructor": {
          "fg": "#61afef"
        },
        "type": {
          "fg": "#e5c07b"
        },
        "namespace": {
          "fg": "#e5c07b"
        },
        "variable": {
          "fg": "#abb2bf"
        },
        "variable.builtin": {
          "fg": "#e06c75"
        },
        "variable.member": {
          "fg": "#e06c75"
        },
        "property": {
          "fg": "#abb2bf"
        },
        "attribute": {
          "fg": "#d19a66"
        },
        "tag": {
          "fg": "#e06c75"
        },
        "operator": {
          "fg": "#c678dd"
        },
        "punctuation": {
          "fg": "#abb2bf"
        },
        "punctuation.special": {
          "fg": "#56b6c2"
        },
        "label": {
          "fg": "#abb2bf",
          "underline": true
        },
        "escape": {
          "fg": "#98c379"
        },
        "embedded": {
          "fg": "#abb2bf"
        },
        "error": {
          "fg": "#e06c75"
        },
        "markup.heading": {
          "fg": "#e06c75",
          "bold": true
        },
        "markup.strong": {
          "fg": "#d19a66",
          "bold": true
        },
        "markup.italic": {
          "fg": "#c678dd",
          "italic": true
        },
        "markup.raw": {
          "fg": "#98c379"
        },
        "markup.link": {
          "fg": "#56b6c2"
        },
        "markup.link.url": {
          "fg": "#56b6c2",
          "underline": true
        },
        "markup.list": {
          "fg": "#e06c75"
        },
        "markup.quote": {
          "fg": "#5c6370",
          "italic": true
        }
      }
    }
  ]
}
