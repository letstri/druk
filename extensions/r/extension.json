{
  "id": "r",
  "name": "R",
  "version": "1.0.0",
  "description": "R highlighting and the languageserver R package - the language of statistics and data analysis, its .R scripts and .Rprofile.",
  "languages": [
    {
      "id": "r",
      "lineComment": "#",
      "extensions": [".r", ".rprofile"],
      "patterns": [
        {
          "group": "variable",
          "re": "`[^`\\n]*`"
        },
        {
          "group": "boolean",
          "re": "\\b(?:TRUE|FALSE)\\b"
        },
        {
          "group": "constant",
          "re": "\\b(?:NULL|NA|NA_integer_|NA_real_|NA_character_|NA_complex_|Inf|NaN)\\b|\\.\\.\\.|\\.\\.\\d+"
        },
        {
          "group": "namespace",
          "re": "\\b[A-Za-z.][A-Za-z0-9._]*(?=:::?)"
        },
        {
          "group": "property",
          "re": "(?<=[$@])[A-Za-z.][A-Za-z0-9._]*"
        },
        {
          "group": "function",
          "re": "\\b[A-Za-z.][A-Za-z0-9._]*(?=\\s*\\()"
        },
        {
          "group": "keyword",
          "re": "\\b(?:if|else|for|while|repeat|function|return|break|next|in)\\b"
        },
        {
          "group": "operator",
          "re": "%[^%\\n]*%|<<-|->>|<-|->|\\|>|\\*\\*|[-+*/^<>=!&|~?:$@]"
        },
        {
          "group": "number",
          "re": "\\b0[xX][0-9a-fA-F]+L?\\b|\\b\\d+(?:\\.\\d*)?(?:[eE][+-]?\\d+)?[Li]?\\b|\\.\\d+(?:[eE][+-]?\\d+)?[Li]?"
        },
        {
          "group": "string",
          "re": "\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'"
        },
        {
          "group": "comment",
          "re": "(?<=^(?:[^\"'#\\n]|\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*')*)#[^\\n]*",
          "flags": "gm"
        }
      ]
    }
  ],
  "languageServers": [
    {
      "id": "r",
      "command": ["R", "--no-echo", "--no-init-file", "-e", "languageserver::run()"],
      "filetypes": ["r"],
      "install": {
        "kind": "manual",
        "command": "R -e 'install.packages(\"languageserver\")'"
      }
    }
  ]
}
