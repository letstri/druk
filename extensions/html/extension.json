{
  "id": "html",
  "name": "HTML",
  "version": "1.1.0",
  "description": "HTML highlighting and the VS Code HTML server.",
  "languages": [
    {
      "id": "html",
      "blockComment": ["<!--", "-->"],
      "grammar": {
        "vendored": "html"
      }
    }
  ],
  "languageServers": [
    {
      "id": "html",
      "command": ["vscode-html-language-server", "--stdio"],
      "filetypes": ["html"],
      "install": {
        "kind": "npm",
        "packages": ["vscode-langservers-extracted"]
      }
    }
  ]
}
