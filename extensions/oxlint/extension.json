{
  "id": "oxlint",
  "name": "oxlint",
  "version": "1.0.0",
  "description": "oxlint diagnostics from the project's own oxlint, beside whatever language server is already serving the file. The oxc linter, in Rust.",
  "languageServers": [
    {
      "id": "oxlint",
      "command": ["oxlint", "--lsp"],
      "filetypes": [
        "typescript",
        "typescriptreact",
        "javascript",
        "javascriptreact",
        "vue",
        "svelte"
      ],
      "install": {
        "kind": "npm",
        "packages": ["oxlint"]
      },
      "settings": {
        "run": "onType"
      }
    }
  ]
}
